body {
  margin:0;
  background:black;
  overflow:hidden;
  font-family:Arial;
  color:white;
}

#menu {
  position:absolute;
  width:100%;
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:black;
}

canvas {
  display:block;
}

#ui {
  position:absolute;
  top:10px;
  left:10px;
}
